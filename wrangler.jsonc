{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "packagist-mirror",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "packages.shyim.de",
			"custom_domain": true,
		},
	],
	"cache": {
		"enabled": false,
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "packagist-mirror",
			"preview_bucket_name": "packagist-mirror-preview",
		},
	],
	"vars": {
		"UPSTREAM_REPO": "https://repo.packagist.org",
		"UPSTREAM_API": "https://packagist.org",
		"CONTACT_EMAIL": "s.sayakci@gmail.com",
		"ALLOWED_DIST_HOSTS": "",
	},
}
